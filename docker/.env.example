# Copy to docker/.env to override the defaults for this checkout, or let
# `docker/anorm-graphql init` generate one with ports that are known to be free.
# docker/.env is gitignored.

# One stack per checkout. Defaults to agq-<directory name>, which keeps a
# worktree's containers and volumes separate from the main checkout's.
#COMPOSE_PROJECT_NAME=agq-anorm-graphql

# Published ports. Bump these if another stack already owns them — the
# .devcontainer stack does not publish MariaDB, but another anorm-graphql worktree will.
#DB_PORT=3319
#PMA_PORT=8099

# Xdebug is off by default; set a mode here to enable it for the whole stack,
# or prefix a single command instead (XDEBUG_MODE=debug docker/anorm-graphql php ...).
# `docker/anorm-graphql coverage` and `ci` set coverage mode themselves.
#XDEBUG_MODE=off
#XDEBUG_CONFIG=client_port=9000

# Set to 0 to stop the entrypoint running composer install on first start.
#AUTO_COMPOSER_INSTALL=1

# The interpreter to build. 7.4-cli is the supported floor and the point of
# this stack; set 8.0-cli ... 8.3-cli and `up --build` to check a newer one.
#PHP_VARIANT=7.4-cli
#MARIADB_VERSION=10.11

# Test database. These defaults match .devcontainer, .github/workflows/ci.yml
# and TestEnvironment::pdo()'s fallbacks — change them all together or not
# at all.
#DB_NAME=anorm_graphql_test
#DB_USER=dev
#DB_PASS=dev
#DB_ROOT_PASSWORD=root

# The container user is remapped to these so files written in the container are
# owned by you on the host. docker/anorm-graphql fills them in from `id -u` / `id -g`.
#USER_UID=1000
#USER_GID=1000
