{
    "name": "saygoweb/anorm-graphql",
    "description": "GraphQL Types, Inputs and tests generated from Anorm models, and the runtime they share",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "cambell",
            "email": "cambell.prince@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "saygoweb/anorm": "^3.2",
        "webonyx/graphql-php": "^15.32.3",
        "php-di/php-di": "^6.0",
        "wp-cli/php-cli-tools": "^0.11.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "phpunit/phpunit": "Needed to extend Anorm\\GraphQL\\Testing\\ModelTypeTestCase in your own test suite"
    },
    "autoload": {
        "psr-4": {
            "Anorm\\GraphQL\\Tools\\": "tools/src/",
            "Anorm\\GraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anorm\\GraphQL\\Test\\": "test/"
        }
    },
    "bin": ["bin/anorm-graphql.php"],
    "scripts": {
        "test": "phpunit",
        "test:quick": "phpunit -c phpunit-no-coverage.xml --testsuite runtime,tools",
        "test:coverage": "phpunit --coverage-html build/coverage --coverage-text",
        "test:ci": "phpunit --coverage-clover=build/logs/clover.xml",
        "cs:check": "phpcs",
        "cs:fix": "phpcbf",
        "analyze": "phpstan analyse --memory-limit=512M",
        "quality": [
            "@cs:check",
            "@analyze"
        ],
        "ci": [
            "@test:ci",
            "@quality"
        ]
    }
}
