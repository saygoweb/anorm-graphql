parameters:
    level: 5
    paths:
        - src
        - tools/src
        - test
    excludePaths:
        - test/Fixtures/golden
        - test/Fixtures/schema
        - vendor
    ignoreErrors:
        -
            # CliBase\Type\Widget\WidgetType is generated by the CLI into the test's temp
            # dir at run time; it does not exist for static analysis to find.
            message: '#CliBase\\Type\\Widget\\WidgetType#'
            path: test/tools/CliTest.php
