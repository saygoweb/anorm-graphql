parameters:
    level: 5
    paths:
        - src
        - tools/src
        - test
    excludePaths:
        - test/Fixtures/golden
        - test/Fixtures/schema
        - vendor
    ignoreErrors:
        -
            # CliBase\Type\Widget\WidgetType is generated by the CLI into the test's temp
            # dir at run time; it does not exist for static analysis to find.
            message: '#CliBase\\Type\\Widget\\WidgetType#'
            path: test/tools/CliTest.php
        -
            # CliCu\Type\Widget\Widget{Create,Update}Input are generated by the CLI into
            # the test's temp dir at run time (--mutations create-update); they do not
            # exist for static analysis to find.
            message: '#CliCu\\Type\\Widget\\Widget(Create|Update)Input#'
            path: test/tools/CliTest.php
