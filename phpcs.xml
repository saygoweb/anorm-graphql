<?xml version="1.0"?>
<ruleset name="anorm-graphql Coding Standard">
    <description>PSR-12, as in Anorm</description>

    <rule ref="PSR12"/>

    <file>src</file>
    <file>test</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <!-- Expected generator output and whole-file schema cases: their shape is the test. -->
    <exclude-pattern>test/Fixtures/golden/*</exclude-pattern>
    <exclude-pattern>test/Fixtures/schema/*</exclude-pattern>

    <arg value="p"/>
    <arg name="colors"/>
    <arg value="s"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="150"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
        <!-- These tests hold literal lines of PHP source; wrapping them would hide what is being tested. -->
        <exclude-pattern>test/tools/Schema/*</exclude-pattern>
    </rule>
</ruleset>
